# Copy to .env and adjust. Every value has a safe local default.
DATABASE_URL=sqlite:///./leadpilot.db
# Leave empty to run the AI copilot with the offline fake provider.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5

# DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO
# Browser origins allowed to call the API (JSON list), e.g. ["http://localhost:5173"].
CORS_ORIGINS=[]
# true: add sample records to an empty database at startup.
SEED_DEMO=false
# Largest request body accepted, in bytes.
MAX_BODY_BYTES=1048576
# Requests per client and per minute (0 = no limit).
RATE_LIMIT_PER_MINUTE=0
# true only behind a proxy that appends the client address to X-Forwarded-For.
TRUST_FORWARDED_FOR=false
